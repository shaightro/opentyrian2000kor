msgctxt "ui.window_size.auto"
msgid "Auto (%dx)"
msgstr "자동 (%dx)"

#. 화면 맞춤 방식 값: 확대하지 않고 가운데
msgctxt "ui.scaling.center"
msgid "Center"
msgstr "가운데"

