# OpenTyrian2000 한국어 번역: ui.po
#
# - msgctxt는 게임이 문장을 찾는 열쇠입니다. 바꾸지 마세요.
# - msgid는 영어 원문, msgstr에 한국어 번역을 씁니다. 비워 두면 영어가 나옵니다.
# - ~로 감싼 부분은 강조(더 밝게) 표시입니다. ~ 기호는 그대로 두세요.
# - %d 같은 자리 표시자는 그대로 두세요.
# - "최대 N바이트"는 게임 안의 칸 크기입니다. 한글 한 글자는 3바이트입니다.
# - 확인이 필요한 번역은 앞에 "#, fuzzy" 줄을 두면 게임이 쓰지 않습니다.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"

#. 메인 메뉴 항목 (보통 글씨). OpenTyrian이 추가한 설정 메뉴. 최대 84바이트 (한글 약 28자)
msgctxt "ui.menu.setup"
msgid "Setup"
msgstr "설정"

#. 설정 메뉴 제목 (큰 글씨)
msgctxt "ui.setup.title"
msgid "Setup"
msgstr "설정"

#. 설정 메뉴 항목 (보통 글씨, 약 130픽셀)
msgctxt "ui.setup.graphics"
msgid "Graphics..."
msgstr "그래픽..."

#. 화면 아래 설명 (작은 글씨, 한 줄)
msgctxt "ui.setup.graphics_desc"
msgid "Change the graphics settings."
msgstr "그래픽 설정을 바꿉니다."

#. 설정 메뉴 항목
msgctxt "ui.setup.sound"
msgid "Sound..."
msgstr "소리..."

#. 화면 아래 설명
msgctxt "ui.setup.sound_desc"
msgid "Change the sound settings."
msgstr "소리 설정을 바꿉니다."

#. 설정 메뉴 항목 이름 (보통 글씨, 약 130픽셀). 공격형 특수 무기를 발사 버튼을 누르고 있는 동안 계속 쓰는 기능
msgctxt "ui.setup.auto_fire_special"
msgid "Auto Special:"
msgstr "특수 무기 연사:"

#. 화면 아래 설명 (작은 글씨, 한 줄)
msgctxt "ui.setup.auto_fire_special_desc"
msgid "Hold fire to keep using an attack special."
msgstr "발사 버튼을 누르고 있으면 공격형 특수 무기를 계속 씁니다."

#. 설정 메뉴 항목 이름 (보통 글씨, 약 130픽셀). 아이템이 걸린 적(기다렸다 부수면 더 좋은 아이템을 주는 적, 부수거나 살려 보내면 나중에 아이템이 나오는 적)을 테두리로 표시하는 기능
msgctxt "ui.setup.drop_hints"
msgid "Item Hints:"
msgstr "아이템 힌트 표시:"

#. 화면 아래 설명 (작은 글씨, 한 줄). 테두리 색의 뜻: 노랑은 기다릴 적, 초록은 지금 부술 적, 빨강은 부수면 나중에 아이템이 나오는 적, 파랑은 살려 보내면 나중에 아이템이 나오는 적
msgctxt "ui.setup.drop_hints_desc"
msgid "Frames: yellow wait, green now, red destroy, blue let go."
msgstr "노랑: 기다리기, 초록: 지금, 빨강: 부수기, 파랑: 살려 보내기"

#. 설정 메뉴 항목 (게임 음악 듣기)
msgctxt "ui.setup.jukebox"
msgid "Jukebox"
msgstr "음악 감상"

#. 화면 아래 설명
msgctxt "ui.setup.jukebox_desc"
msgid "Listen to the music of Tyrian."
msgstr "티리안의 음악을 들어 봅니다."

#. 메뉴를 닫는 항목
msgctxt "ui.setup.done"
msgid "Done"
msgstr "완료"

#. 화면 아래 설명
msgctxt "ui.setup.done_desc"
msgid "Return to the main menu."
msgstr "메인 메뉴로 돌아갑니다."

#. 그래픽 설정 메뉴 제목 (큰 글씨)
msgctxt "ui.graphics.title"
msgid "Graphics"
msgstr "그래픽"

#. 그래픽 설정 항목 이름 (보통 글씨, 약 130픽셀)
msgctxt "ui.graphics.display"
msgid "Display:"
msgstr "화면:"

#. 화면 아래 설명
msgctxt "ui.graphics.display_desc"
msgid "Change the display mode."
msgstr "화면 모드를 바꿉니다."

#. 그래픽 설정 항목 이름
msgctxt "ui.graphics.window_size"
msgid "Window Size:"
msgstr "창 크기:"

#. 화면 아래 설명
msgctxt "ui.graphics.window_size_desc"
msgid "Change the window size (in Window mode)."
msgstr "창 크기를 바꿉니다 (창 모드일 때)."

#. 그래픽 설정 항목 이름 (픽셀 확대 방식)
msgctxt "ui.graphics.scaler"
msgid "Scaler:"
msgstr "확대 방식:"

#. 화면 아래 설명
msgctxt "ui.graphics.scaler_desc"
msgid "Change the pixel art scaling algorithm."
msgstr "픽셀을 확대하는 방식을 바꿉니다."

#. 그래픽 설정 항목 이름 (화면 맞춤 방식)
msgctxt "ui.graphics.scaling_mode"
msgid "Scaling Mode:"
msgstr "화면 맞춤:"

#. 화면 아래 설명
msgctxt "ui.graphics.scaling_mode_desc"
msgid "Change the scaling mode."
msgstr "화면에 맞추는 방식을 바꿉니다."

#. 화면 아래 설명
msgctxt "ui.done_previous_desc"
msgid "Return to the previous menu."
msgstr "이전 메뉴로 돌아갑니다."

#. 소리 설정 메뉴 제목 (큰 글씨)
msgctxt "ui.sound.title"
msgid "Sound"
msgstr "소리"

#. 소리 설정 항목 이름
msgctxt "ui.sound.music_volume"
msgid "Music Volume"
msgstr "음악 음량"

#. 소리 설정 항목 이름 (효과음)
msgctxt "ui.sound.effects_volume"
msgid "Sound Volume"
msgstr "효과음 음량"

#. 화면 아래 설명
msgctxt "ui.sound.volume_desc"
msgid "Change volume with the left/right arrow keys."
msgstr "왼쪽/오른쪽 방향키로 음량을 바꿉니다."

#. 화면 모드 값: 창 모드 (보통 글씨, 약 95픽셀)
msgctxt "ui.display.window"
msgid "Window"
msgstr "창 모드"

#. 화면 모드 값: n번 모니터 전체 화면. %d(모니터 번호)는 그대로 두세요
msgctxt "ui.display.n"
msgid "Display %d"
msgstr "%d번 모니터"

#. 창 크기 값: 자동. %d(배수)는 그대로 두세요
msgctxt "ui.window_size.auto"
msgid "Auto (%dx)"
msgstr "자동 (%dx)"

#. 화면 맞춤 방식 값: 확대하지 않고 가운데
msgctxt "ui.scaling.center"
msgid "Center"
msgstr "가운데"

#. 화면 맞춤 방식 값: 정수배로만 확대
msgctxt "ui.scaling.integer"
msgid "Integer"
msgstr "정수배"

#. 화면 맞춤 방식 값: 8:5 비율로 꽉 차게
msgctxt "ui.scaling.fit_8_5"
msgid "Fit 8:5"
msgstr "8:5 맞춤"

#. 화면 맞춤 방식 값: 4:3 비율(옛 CRT)로 꽉 차게
msgctxt "ui.scaling.fit_4_3"
msgid "Fit 4:3"
msgstr "4:3 맞춤"

#. 켜고 끄는 설정의 값: 켜짐 (보통 글씨, 약 95픽셀)
msgctxt "ui.option.on"
msgid "On"
msgstr "켬"

#. 켜고 끄는 설정의 값: 꺼짐 (보통 글씨, 약 95픽셀)
msgctxt "ui.option.off"
msgid "Off"
msgstr "끔"

#. 쉬움 난이도를 고르면 아래에 나오는 추가 옵션 이름 (보통 글씨, 약 160픽셀). 플레이어가 받는 피해를 절반으로 줄이는 기능
msgctxt "ui.easy.half_damage"
msgid "Half Damage:"
msgstr "받는 피해 절반:"

#. 쉬움 추가 옵션 이름 (보통 글씨, 약 160픽셀). 새 게임의 시작 자금
msgctxt "ui.easy.start_cash"
msgid "Starting Cash:"
msgstr "시작 자금:"

#. 시작 자금 옵션의 값: 원래대로 (보통 글씨, 약 90픽셀)
msgctxt "ui.easy.cash_normal"
msgid "Normal"
msgstr "기본"

#. 시작 자금 옵션의 값: 100만 크레딧 (보통 글씨, 약 90픽셀)
msgctxt "ui.easy.cash_rich"
msgid "1,000,000"
msgstr "1,000,000"

#. 쉬움 추가 옵션 이름 (보통 글씨, 약 160픽셀). 첫 상점에 좋은 장비를 더 파는 기능
msgctxt "ui.easy.good_gear"
msgid "Good Gear in Shop:"
msgstr "시작 상점 좋은 장비:"

#. 쉬움 추가 옵션 아래의 게임 시작 항목 (보통 글씨, 짧게)
msgctxt "ui.easy.start"
msgid "Start"
msgstr "시작"

#. 쉬움 추가 옵션의 조작 안내 (작은 글씨, 화면 아래 한 줄, 약 300픽셀)
msgctxt "ui.easy.help"
msgid "Left/Right: change   Enter: select   ESC: back"
msgstr "좌우: 바꾸기   엔터: 선택   ESC: 돌아가기"

#. 음악 감상 화면 아래 안내 (작은 글씨, 한 줄)
msgctxt "ui.jukebox.quit"
msgid "Press ESC to quit the jukebox."
msgstr "ESC를 누르면 음악 감상을 끝냅니다."

#. 음악 감상 화면 아래 안내
msgctxt "ui.jukebox.keys"
msgid "Arrow keys change the song being played."
msgstr "방향키로 곡을 바꿉니다."

#. 게임 중 경고 표시 (작은 글씨, 짧게)
msgctxt "ui.warning"
msgid "WARNING"
msgstr "경고"

#. 치트를 쓴 사람에게 보이는 농담 문구
msgctxt "ui.cheaters"
msgid "Cheaters always prosper."
msgstr "치트를 쓰는 자가 늘 이기는 법."

#. 숨겨진 미니게임 Destruct의 모드 이름
msgctxt "ui.destruct.custom"
msgid "Custom"
msgstr "사용자 정의"

#. 다음 레벨 선택 메뉴의 제목 (큰 글씨, 짧게)
msgctxt "ui.next_level"
msgid "Next Level"
msgstr "다음 레벨"

#. 상점의 아이템 가격 (작은 글씨). %d(가격)는 그대로 두세요
msgctxt "ui.cost"
msgid "Cost: %d"
msgstr "가격: %d"

#. 상점의 무기·사이드킥 초당 피해량 (작은 글씨, 가격 줄 오른쪽, 약 50픽셀). %s는 숫자이고, 후방 무기는 "30/45"처럼 두 발사 방식이 함께 들어갑니다
msgctxt "ui.shop.dps"
msgid "DPS %s"
msgstr "초당 피해 %s"

#. 상점의 탄약 제한 사이드킥의 한 발 피해량 (작은 글씨, 가격 줄 오른쪽, 약 50픽셀). %d는 숫자
msgctxt "ui.shop.damage_per_shot"
msgid "%d/shot"
msgstr "발당 피해 %d"

#. 상점의 사용자 정의 함선 이름. %d(번호)는 그대로 두세요
msgctxt "ui.custom_ship"
msgid "Custom Ship %d"
msgstr "맞춤 함선 %d"

#. 슈퍼 아케이드 모드를 마친 뒤 나오는 안내. %s는 미니게임 이름입니다
msgctxt "ui.or_play"
msgid "Or play... %s"
msgstr "아니면 이 게임도... %s"

#. 슈퍼 아케이드 모드를 마친 뒤 나오는 비밀 코드 안내. %s는 타이틀 화면에서 입력할 코드입니다 (영어 그대로)
msgctxt "ui.type_at_title"
msgid "Type %s at Title"
msgstr "타이틀 화면에서 %s 입력"

#. 도움말 화면 오른쪽 아래의 쪽 번호. %s는 "페이지 3" 같은 현재 쪽, %d는 전체 쪽 수입니다 (작은 글씨)
msgctxt "ui.page_of"
msgid "%s of %d"
msgstr "%s / %d"

#. 불러오기 메뉴에서 레벨을 시작할 때 자동으로 저장되는 칸의 이름 (작은 글씨, 짧게)
msgctxt "ui.last_level_slot"
msgid "LAST LEVEL"
msgstr "자동 저장"

#. 숨겨진 미니게임 Destruct 위쪽 칸의 차량 내구도. %d는 숫자, ~는 강조 (작은 글씨, 약 30픽셀)
msgctxt "ui.destruct.damage"
msgid "dmg~%d~"
msgstr "체력~%d~"

#. 숨겨진 미니게임 Destruct 위쪽 칸의 점수. %d는 숫자, ~는 강조 (작은 글씨, 약 30픽셀)
msgctxt "ui.destruct.points"
msgid "pts~%d~"
msgstr "점수~%d~"

