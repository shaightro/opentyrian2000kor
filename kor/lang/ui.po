msgctxt "ui.scaling.fit_4_3"
msgid "Fit 4:3"
msgstr "4:3 맞춤"

#. 음악 감상 화면 아래 안내 (작은 글씨, 한 줄)
msgctxt "ui.jukebox.quit"
msgid "Press ESC to quit the jukebox."
msgstr "ESC를 누르면 음악 감상을 끝냅니다."

#. 음악 감상 화면 아래 안내
msgctxt "ui.jukebox.keys"
msgid "Arrow keys change the song being played."
msgstr "방향키로 곡을 바꿉니다."

#. 게임 중 경고 표시 (작은 글씨, 짧게)
msgctxt "ui.warning"
msgid "WARNING"
msgstr "경고"

#. 치트를 쓴 사람에게 보이는 농담 문구
msgctxt "ui.cheaters"
msgid "Cheaters always prosper."
msgstr "치트를 쓰는 자가 늘 이기는 법."

#. 숨겨진 미니게임 Destruct의 모드 이름
msgctxt "ui.destruct.custom"
msgid "Custom"
msgstr "사용자 정의"

#. 다음 레벨 선택 메뉴의 제목 (큰 글씨, 짧게)
msgctxt "ui.next_level"
msgid "Next Level"
msgstr "다음 레벨"

