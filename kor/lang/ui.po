# OpenTyrian2000 한국어 번역: ui.po
#
# - msgctxt는 게임이 문장을 찾는 열쇠입니다. 바꾸지 마세요.
# - msgid는 영어 원문, msgstr에 한국어 번역을 씁니다. 비워 두면 영어가 나옵니다.
# - ~로 감싼 부분은 강조(더 밝게) 표시입니다. ~ 기호는 그대로 두세요.
# - %d 같은 자리 표시자는 그대로 두세요.
# - "최대 N바이트"는 게임 안의 칸 크기입니다. 한글 한 글자는 3바이트입니다.
# - 확인이 필요한 번역은 앞에 "#, fuzzy" 줄을 두면 게임이 쓰지 않습니다.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"

#. 메인 메뉴 항목 (보통 글씨). OpenTyrian이 추가한 설정 메뉴. 최대 84바이트 (한글 약 28자)
msgctxt "ui.menu.setup"
msgid "Setup"
msgstr "설정"

#. 설정 메뉴 제목 (큰 글씨)
msgctxt "ui.setup.title"
msgid "Setup"
msgstr "설정"

#. 설정 메뉴 항목 (보통 글씨, 약 130픽셀)
msgctxt "ui.setup.graphics"
msgid "Graphics..."
msgstr "그래픽..."

#. 화면 아래 설명 (작은 글씨, 한 줄)
msgctxt "ui.setup.graphics_desc"
msgid "Change the graphics settings."
msgstr "그래픽 설정을 바꿉니다."

#. 설정 메뉴 항목
msgctxt "ui.setup.sound"
msgid "Sound..."
msgstr "소리..."

#. 화면 아래 설명
msgctxt "ui.setup.sound_desc"
msgid "Change the sound settings."
msgstr "소리 설정을 바꿉니다."

#. 설정 메뉴 항목 (게임 음악 듣기)
msgctxt "ui.setup.jukebox"
msgid "Jukebox"
msgstr "음악 감상"

#. 화면 아래 설명
msgctxt "ui.setup.jukebox_desc"
msgid "Listen to the music of Tyrian."
msgstr "티리안의 음악을 들어 봅니다."

#. 메뉴를 닫는 항목
msgctxt "ui.setup.done"
msgid "Done"
msgstr "완료"

#. 화면 아래 설명
msgctxt "ui.setup.done_desc"
msgid "Return to the main menu."
msgstr "메인 메뉴로 돌아갑니다."

#. 그래픽 설정 메뉴 제목 (큰 글씨)
msgctxt "ui.graphics.title"
msgid "Graphics"
msgstr "그래픽"

#. 그래픽 설정 항목 이름 (보통 글씨, 약 130픽셀)
msgctxt "ui.graphics.display"
msgid "Display:"
msgstr "화면:"

#. 화면 아래 설명
msgctxt "ui.graphics.display_desc"
msgid "Change the display mode."
msgstr "화면 모드를 바꿉니다."

#. 그래픽 설정 항목 이름
msgctxt "ui.graphics.window_size"
msgid "Window Size:"
msgstr "창 크기:"

#. 화면 아래 설명
msgctxt "ui.graphics.window_size_desc"
msgid "Change the window size (in Window mode)."
msgstr "창 크기를 바꿉니다 (창 모드일 때)."

#. 그래픽 설정 항목 이름 (픽셀 확대 방식)
