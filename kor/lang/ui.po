msgctxt "ui.or_play"
msgid "Or play... %s"
msgstr "아니면 이 게임도... %s"

#. 슈퍼 아케이드 모드를 마친 뒤 나오는 비밀 코드 안내. %s는 타이틀 화면에서 입력할 코드입니다 (영어 그대로)
msgctxt "ui.type_at_title"
msgid "Type %s at Title"
msgstr "타이틀 화면에서 %s 입력"


#. 도움말 화면 오른쪽 아래의 쪽 번호. %s는 "페이지 3" 같은 현재 쪽, %d는 전체 쪽 수입니다 (작은 글씨)
msgctxt "ui.page_of"
msgid "%s of %d"
msgstr "%s / %d"
