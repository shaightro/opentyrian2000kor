msgctxt "ui.done_previous_desc"
msgid "Return to the previous menu."
msgstr "이전 메뉴로 돌아갑니다."

#. 소리 설정 메뉴 제목 (큰 글씨)
msgctxt "ui.sound.title"
msgid "Sound"
msgstr "소리"

#. 소리 설정 항목 이름
msgctxt "ui.sound.music_volume"
msgid "Music Volume"
msgstr "음악 음량"

#. 소리 설정 항목 이름 (효과음)
msgctxt "ui.sound.effects_volume"
msgid "Sound Volume"
msgstr "효과음 음량"

#. 화면 아래 설명
msgctxt "ui.sound.volume_desc"
msgid "Change volume with the left/right arrow keys."
msgstr "왼쪽/오른쪽 방향키로 음량을 바꿉니다."

#. 화면 모드 값: 창 모드 (보통 글씨, 약 95픽셀)
msgctxt "ui.display.window"
msgid "Window"
msgstr "창 모드"

#. 화면 모드 값: n번 모니터 전체 화면. %d(모니터 번호)는 그대로 두세요
msgctxt "ui.display.n"
msgid "Display %d"
msgstr "%d번 화면"

