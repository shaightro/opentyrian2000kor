msgid "~Ignatz~ : Twirling U-ship : 15 pts"
msgstr "~이그나츠~ : 빙글빙글 도는 U자 함선 : 15점"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube1.33.18"
msgid "~Morble~ : Spinning O-ship : 20 pts"
msgstr "~모블~ : 회전하는 O자 함선 : 20점"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
