# OpenTyrian2000 한국어 번역: cubes4.po
#
# - msgctxt는 게임이 문장을 찾는 열쇠입니다. 바꾸지 마세요.
# - msgid는 영어 원문, msgstr에 한국어 번역을 씁니다. 비워 두면 영어가 나옵니다.
# - ~로 감싼 부분은 강조(더 밝게) 표시입니다. ~ 기호는 그대로 두세요.
# - %d 같은 자리 표시자는 그대로 두세요.
# - "최대 N바이트"는 게임 안의 칸 크기입니다. 한글 한 글자는 3바이트입니다.
# - 확인이 필요한 번역은 앞에 "#, fuzzy" 줄을 두면 게임이 쓰지 않습니다.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ko\n"

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
msgctxt "cube4.4.title"
msgid "IXMUCANE - PRIVATE LINK"
msgstr "익스무카네 - 개인 회선"

#. 데이터 큐브를 읽을 때 위에 나오는 제목 (큰 글씨, 아주 짧게). 최대 36바이트 (한글 약 12자)
msgctxt "cube4.4.header"
msgid "Tech"
msgstr "기술자"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.0"
msgid "Tightbeam private coded message. Forwarded by Downstar at unknown link. Attached message included as second data message."
msgstr "지향성 빔 개인 암호 메시지. 다운스타가 미상의 회선을 통해 전달함. 첨부 메시지는 두 번째 데이터 메시지로 포함됨."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.4"
msgid "Decoded transmission follows:"
msgstr "해독된 통신 내용은 다음과 같음:"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.6"
msgid "This is ~Harble~ ~Wom~ at the ~Microsol~ planet ~Ixmucane~.  This is a ~Downstar~ emergency request by ~Downstar~ agent ID ~00329~, Tech ~IX9204~.  I am patched into a secure net and cannot explain fully."
msgstr "여기는 ~마이크로솔~ 소유 행성 ~익스무카네~의 ~하블~ ~웜~입니다. ~다운스타~ 요원 ID ~00329~, 기술자 ~IX9204~가 보내는 ~다운스타~ 긴급 요청입니다. 보안망에 몰래 접속해 있어서 자세히 설명할 수가 없습니다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.10"
msgid "Through collaborating with other Techs, I have learned that ~Microsol~ has unlocked some of the ~Zica~ command codes.  The SCIs have activated the ancient computer system!  Temperature is 103° here in the service bay and rising.  Men are complaining but being turned away by the guards.  I fear that only armed conflict will prevent our massacre.  Several Techs are reported missing and we fear they were killed for trying to escape."
msgstr "다른 기술자들과 힘을 합친 끝에, ~마이크로솔~이 ~지카~ 명령 코드 일부를 풀어냈다는 사실을 알아냈습니다. 과학자들이 그 고대 컴퓨터 시스템을 가동시켰습니다! 이곳 정비실 온도는 103도이고 계속 오르고 있습니다. 사람들이 항의해 보지만 경비병들에게 번번이 쫓겨나고 있습니다. 무력 충돌이라도 일어나지 않는 한 우리는 몰살당할 것 같습니다. 기술자 몇 명이 실종됐다는 보고가 있는데, 탈출하려다 살해당한 게 아닌가 싶습니다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.17"
msgid "I think..."
msgstr "제 생각엔..."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.19"
msgid "I think they're going to turn this planet into a sun."
msgstr "놈들은 이 행성을 태양으로 만들려는 것 같습니다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.21"
msgid "GET ME OUT OF HERE!"
msgstr "여기서 꺼내 줘요!"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.23"
msgid "I DON'T WANT TO BE CAUGHT OUT IN THE MIDDLE OF THIS PLANET WHEN THEY TURN IT INTO A SUN!!!!"
msgstr "놈들이 이 행성을 태양으로 바꿀 때 행성 한복판에 갇혀 있긴 싫다고요!!!!"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.26"
msgid "~SEND~ ~SOMEONE~ ~OUT~ ~NOW~ ~YOU~ ~STUPID~"
msgstr "~당장~ ~누구라도~ ~보내란~ ~말이야~ ~이~ ~멍청이들아~"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.4.28"
msgid "[End of File]"
msgstr "[파일 끝]"

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
msgctxt "cube4.5.title"
msgid "INCOMING TRANSMISSION from Gencore Command Ship IcoStar II"
msgstr "젠코어 지휘함 아이코스타 II에서 온 통신"

#. 데이터 큐브를 읽을 때 위에 나오는 제목 (큰 글씨, 아주 짧게). 최대 36바이트 (한글 약 12자)
msgctxt "cube4.5.header"
msgid "Transon"
msgstr "트랜슨"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.0"
msgid "You've probably read the message before this one, Trent.  I don't need to tell you that this is a problem, and it means doom."
msgstr "아마 이 앞의 메시지를 읽었을 걸세, 트렌트. 이게 큰 문제라는 것도, 파멸을 뜻한다는 것도 굳이 말하지 않아도 알 테지."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.3"
msgid "I know I am a boring old man and I dragged you back across the galaxy against your own will, but please hear me out."
msgstr "내가 따분한 늙은이라는 것도, 자네 뜻을 거슬러 은하 저편에서 다시 끌고 왔다는 것도 아네. 그래도 부디 내 말을 끝까지 들어 주게."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.6"
msgid "I am placed in the regrettible position of having to try and stop this insanity.  I hope ~Harble~ was wrong, but this is an alien technology more advanced than our own."
msgstr "나는 어떻게든 이 미친 짓을 막아야 하는 안타까운 처지에 놓였네. ~하블~이 틀렸기를 바라지만, 이건 우리 기술보다 앞선 외계 기술일세."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.10"
msgid "~Gencore~ believes that if ~Microsol~ can reactivate the computer systems, they will have a limitless power source and would certainly monopolize the energy trade."
msgstr "~젠코어~는 ~마이크로솔~이 그 컴퓨터 시스템을 다시 가동하면 무한한 동력원을 손에 넣게 될 테고, 에너지 거래를 독점할 게 분명하다고 보고 있네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.14"
msgid "As regrettible as it would be, if that was all it was I would reluctantly have to allow them to activate the planet and keep their energy.  We could still fight them economically from other directions.  The problem is that there's a vast number of scientists and technicians from independent governments and education centers stationed on ~Ixmucane~ via the universal ~Free~ ~Education~ ~Act~.  At last count, there were about ~1.5~ ~million~ of the brightest minds in the universe centered on ~Ixmucane~.  Now, there's a giant military fleet flying around inside that blasted rock which has prevented nearly everyone from escaping!"
msgstr "유감스럽지만 그게 전부라면, 마지못해서라도 놈들이 행성을 가동해 그 에너지를 차지하게 내버려 둘 수밖에 없을 걸세. 다른 방면에서 경제적으로 맞서 싸울 수도 있으니 말이야. 문제는 범우주 ~자유 교육법~에 따라 ~익스무카네~에 파견된 독립 정부와 교육 기관 소속 과학자와 기술자가 엄청나게 많다는 걸세. 마지막 집계로는 우주에서 가장 뛰어난 두뇌 약 ~150만~ 명이 ~익스무카네~에 모여 있었네. 그런데 지금 그 망할 바위 속을 거대한 군 함대가 날아다니면서 거의 아무도 빠져나가지 못하게 막고 있다네!"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.24"
msgid "If they turn that rock into a sun, it will mean a scientific setback that will last for millenia!  We have much of the information, but few outside the ~Free~ ~Education~ system have the ability to comprehend and utilize it.  While we're busy relearning all that has been lost, ~Microsol~ will undoubtedly push ahead and take over the rest of the colonized universe."
msgstr "놈들이 그 바위를 태양으로 바꿔 버리면, 과학은 수천 년이나 뒷걸음질 치게 될 걸세! 정보는 우리도 많이 갖고 있지만, ~자유 교육~ 체계 바깥에서 그걸 이해하고 활용할 수 있는 사람은 드물다네. 우리가 잃어버린 지식을 다시 익히느라 허덕이는 사이, ~마이크로솔~은 틀림없이 앞서 나가 개척된 우주의 나머지를 몽땅 차지해 버릴 걸세."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.30"
msgid "I can't let that happen, under any cost."
msgstr "무슨 대가를 치르더라도 그렇게 둘 수는 없네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.32"
msgid "We, along with several other major corporations, have assembled an ~emergency~ ~fleet~ which will converge on ~Ixmucane~."
msgstr "우리는 다른 주요 기업 몇 곳과 함께 ~비상 함대~를 꾸렸고, 이 함대가 ~익스무카네~로 집결할 걸세."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.35"
msgid "Yes, Trent, you are part of the ~emergency~ ~fleet~.  During your last maintenance run, we planted some false programming into your computer banks.  After you receive my coded message, your viewscreen will be correctly reactivated. That vacation you were planning will just have to wait.  Glad to have you with us."
msgstr "그렇다네, 트렌트, 자네도 그 ~비상 함대~의 일원일세. 지난번 정비 때 자네 컴퓨터 기억 장치에 가짜 프로그램을 좀 심어 두었네. 내 암호 메시지를 받고 나면 자네 화면이 제대로 다시 켜질 걸세. 계획하던 휴가는 좀 미뤄야겠군. 자네가 함께해 줘서 든든하네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.41"
msgid "We're counting on you to slow them down long enough for us to free the trapped people.  If they activate the planet, we'll somehow make sure they can't use it."
msgstr "우리가 갇힌 사람들을 구해 낼 때까지 자네가 놈들의 발을 묶어 주리라 믿네. 만약 놈들이 행성을 가동한다면, 어떻게든 놈들이 그걸 쓰지 못하게 만들겠네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.5.45"
msgid "And Trent... I don't know if you'll accept this, but I'm sorry."
msgstr "그리고 트렌트... 자네가 받아 줄지 모르겠네만, 미안하네."

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
msgctxt "cube4.6.title"
msgid "INCOMING TRANSMISSION from Gencore Command Ship IcoStar II"
msgstr "젠코어 지휘함 아이코스타 II에서 온 통신"

#. 데이터 큐브를 읽을 때 위에 나오는 제목 (큰 글씨, 아주 짧게). 최대 36바이트 (한글 약 12자)
msgctxt "cube4.6.header"
msgid "Transon"
msgstr "트랜슨"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.0"
msgid "Recorded VidCom - GT 29:21"
msgstr "녹화된 영상 통신 - GT 29:21"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.2"
msgid "I wasn't sure if I was going to hear from you again, but you cleared out enough of the surface ships for us to break through and start rescuing the people trapped on the upper sections of the planet."
msgstr "자네 소식을 다시 듣게 될지 자신이 없었는데, 자네가 지상 함선들을 충분히 쓸어 준 덕분에 우리가 포위를 뚫고 행성 상층부에 갇힌 사람들을 구조하기 시작했네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.6"
msgid "We need more time, Trent.  The temperature is rising even on the surface now, and it's a matter of minutes before it's deadly.  You've got to fly down into the planet and distract whatever's in the core.  We've destroyed enough of their jamming beacons to scan the interior of the planet and have located a central shaft leading deep into the planet.  The coordinates were downloaded into your computer with this message."
msgstr "시간이 더 필요하네, 트렌트. 이제 지표면에서도 온도가 오르고 있어서, 치명적인 수준이 되기까지 몇 분 남지 않았네. 자네가 행성 안으로 날아 들어가 중심핵에 있는 뭔가의 주의를 끌어 줘야 하네. 놈들의 전파 방해 비컨을 충분히 부순 덕에 행성 내부를 스캔할 수 있었는데, 행성 깊숙이 이어지는 중앙 수직 통로를 찾아냈네. 좌표는 이 메시지와 함께 자네 컴퓨터로 내려보냈네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.13"
msgid "Good luck.  We'll try to save as many as possible before the planet goes."
msgstr "행운을 비네. 행성이 끝장나기 전에 최대한 많은 사람을 구해 보겠네."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.15"
msgid "Further communications won't be possible from me, but there's some friendly groups in the lower sections who have seized control.  They will probably try to contact you and may be able to provide assistance.  A robot service vehicle has been despatched to follow you down.  It's all we can spare."
msgstr "이제 내 쪽에서는 더 연락할 수 없겠지만, 하층부에 통제권을 장악한 우호 세력이 몇 있네. 아마 자네에게 연락해 올 테고, 도움을 줄 수도 있을 걸세. 자네를 따라 내려가도록 로봇 정비선을 한 대 보냈네. 우리가 내줄 수 있는 건 그게 전부일세."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.20"
msgid "We're all depending on you to distract them.  Do what you must."
msgstr "모두 자네가 놈들의 주의를 끌어 주기만을 바라고 있네. 해야 할 일을 하게."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.6.22"
msgid "Transon Lohk"
msgstr "트랜슨 로크"

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
msgctxt "cube4.7.title"
msgid "IXMUCANE - PRIVATE LINK"
msgstr "익스무카네 - 개인 회선"

#. 데이터 큐브를 읽을 때 위에 나오는 제목 (큰 글씨, 아주 짧게). 최대 36바이트 (한글 약 12자)
msgctxt "cube4.7.header"
msgid "Tech"
msgstr "기술자"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.0"
msgid "Tightbeam private coded message. Originating from Ixmucane internal section 12-9-4."
msgstr "지향성 빔 개인 암호 메시지. 발신지: 익스무카네 내부 구역 12-9-4."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.3"
msgid "This is Tech ~Harble~ ~Wom~ from level 12.  We have freed this section from Microsol control and have monitored your incoming ship."
msgstr "여기는 12층의 기술자 ~하블~ ~웜~이에요. 우리가 이 구역을 마이크로솔의 통제에서 해방시켰고, 그쪽 함선이 들어오는 걸 지켜보고 있었어요."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.6"
msgid "You appear to be piloting a neutral freemarket scout-class starship.  Are you here to help?  Did ~Downstar~ send you?"
msgstr "보아하니 중립 자유 시장 소속의 정찰급 우주선을 몰고 있는 것 같군요. 도우러 온 건가요? ~다운스타~가 보냈어요?"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.9"
msgid "We are trapped here in level 12 by a security lockout and can't break through the blast-shielding."
msgstr "우린 보안 봉쇄 때문에 이곳 12층에 갇혀 있는데, 방폭 차폐벽을 뚫을 수가 없어요."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.12"
msgid "Look, whoever you are, we're in a tight spot.  There's no time left for us to escape - the defense drones are inaccessible to these computer systems and none of us can override the security codes.  You gotta help us out. There's thousands of us trapped here in the middle of this rock.  We've got some sensors working and know that someone's up there evacuating the population, but there's no time."
msgstr "이봐요, 누군지는 몰라도 우린 지금 궁지에 몰렸어요. 탈출할 시간이 없어요. 방어 드론은 이쪽 컴퓨터 시스템으로는 손댈 수가 없고, 보안 코드를 해제할 수 있는 사람도 없어요. 우릴 좀 도와줘야 해요. 이 바위 한가운데에 수천 명이 갇혀 있다고요. 센서 몇 개가 살아 있어서 누군가 위에서 주민들을 대피시키고 있다는 건 알지만, 시간이 없어요."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.19"
msgid "This planet is going to vaporize in about 30 minutes, maybe an hour.  There's more of us trapped down below somewhere closer to the core and they can't get out either.  There's just no way you're gonna reach us down here."
msgstr "이 행성은 30분, 길어야 한 시간 안에 증발해 버릴 거예요. 저 아래 중심핵에 더 가까운 어딘가에도 갇힌 사람들이 있는데, 그 사람들도 못 빠져나오고 있어요. 당신이 여기까지 내려올 방법은 도무지 없을 거예요."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.23"
msgid "~Microsol's~ activated some old Zica system down there near the core, and it's raising the temperature something fierce.  You've got to take it out fast or we'll never make it!"
msgstr "~마이크로솔~ 놈들이 저 아래 중심핵 근처에서 오래된 지카 시스템을 가동했는데, 그게 온도를 무섭게 올리고 있어요. 그걸 빨리 없애지 않으면 우린 끝장이에요!"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.27"
msgid "No time!  Just continue down that tunnel!  There's something massive down there burning a hole through the planet!  We sent another data cube with a sensor report of the core.  I hope you got it!"
msgstr "시간 없어요! 그냥 그 터널을 따라 계속 내려가요! 저 아래서 뭔가 거대한 게 행성에 구멍을 태워 뚫고 있어요! 중심핵 센서 보고서를 담은 데이터 큐브를 하나 더 보냈어요. 받았으면 좋겠네요!"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.7.31"
msgid "For the love of Zinglon, save us!"
msgstr "제발요, 징글론을 봐서라도 우릴 살려 줘요!"

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
msgctxt "cube4.8.title"
msgid "ARCHIVE DATA"
msgstr "기록 보관소 자료"

#. 데이터 큐브를 읽을 때 위에 나오는 제목 (큰 글씨, 아주 짧게). 최대 36바이트 (한글 약 12자)
msgctxt "cube4.8.header"
msgid "Data"
msgstr "데이터"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.8.0"
msgid "Reference: Ixmucane Core sensor report"
msgstr "항목: 익스무카네 중심핵 센서 보고서"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.8.2"
msgid "Sensor arrays have detected 3 main types of anomalous readings."
msgstr "센서 배열이 크게 세 종류의 이상 수치를 감지했다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.8.4"
msgid "1 - Unknown Zica defense systems.  Most defense systems are radiating large amounts of infrared energy and are probably thermal based.  An unknown energy force appears to be directing the thermal energy flow."
msgstr "1 - 미확인 지카 방어 시스템. 방어 시스템 대부분이 다량의 적외선 에너지를 방출하고 있어 열 기반일 가능성이 높다. 정체불명의 에너지가 열에너지의 흐름을 조종하는 것으로 보인다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.8.8"
msgid "2 - Crystalline Ore.  A highly volatile, energy-rich crystal ore has been detected in this area.  Dralictite and Morenzinum are indicated in fairly high quantities near the center."
msgstr "2 - 결정질 광석. 이 지역에서 불안정성이 매우 높고 에너지가 풍부한 결정 광석이 감지되었다. 중심부 근처에서 드랄릭타이트와 모렌지늄이 상당히 많이 검출된다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.8.12"
msgid "3 - Large Unknown Energy Source.  A central energy source is producing unknown levels of heat energy.  This source is a critical threat and your heat shielding will last for approximately 30 seconds in contact with the device. You will have approximately 10 seconds to destroy the source when within critical range."
msgstr "3 - 대형 미확인 에너지원. 중앙의 에너지원이 측정할 수 없는 수준의 열에너지를 내뿜고 있다. 이 에너지원은 심각한 위협이며, 장치와 접촉할 경우 기체의 열 차폐막은 약 30초 동안 버틸 것이다. 임계 범위 안에 들어가면 에너지원을 파괴할 시간은 약 10초다."

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
msgctxt "cube4.9.title"
msgid "IXMUCANE - PRIVATE LINK"
msgstr "익스무카네 - 개인 회선"

#. 데이터 큐브를 읽을 때 위에 나오는 제목 (큰 글씨, 아주 짧게). 최대 36바이트 (한글 약 12자)
msgctxt "cube4.9.header"
msgid "Captain"
msgstr "함장"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.9.0"
msgid "Tightbeam private coded message. Originating from Ixmucane internal section 1-1-1."
msgstr "지향성 빔 개인 암호 메시지. 발신지: 익스무카네 내부 구역 1-1-1."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.9.3"
msgid "Who are you?  Don't I recognize you?"
msgstr "넌 누구냐? 어디서 본 얼굴 같은데?"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.9.5"
msgid "No matter.  This planet is going to be vaporized, intruder.  There's no hope for you to reach the core in time to destroy it."
msgstr "상관없지. 이 행성은 곧 증발한다, 침입자. 네가 제때 중심핵까지 가서 그걸 파괴할 가망은 없다."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.9.8"
msgid "Leave now, whoever you are.  This is not your affair.  I'd kill you myself, but I'm not stupid enough to stay behind and die."
msgstr "누군지 몰라도 당장 떠나라. 네가 끼어들 일이 아니다. 내 손으로 죽여 주고 싶지만, 여기 남아서 같이 죽을 만큼 멍청하진 않거든."

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.9.12"
msgid "~Captain~ ~Nob~"
msgstr "~노브~ ~함장~"

#. 데이터 큐브 본문의 한 문단 (작은 글씨). 게임이 자동으로 줄바꿈합니다. 최대 4095바이트 (한글 약 1365자)
msgctxt "cube4.9.14"
msgid "~Ixmucane~ Task Force ~Alpha~"
msgstr "~익스무카네~ 기동대 ~알파~"

#. 데이터 큐브 목록에 나오는 제목 (작은 글씨, 두 줄까지). 최대 240바이트 (한글 약 80자)
